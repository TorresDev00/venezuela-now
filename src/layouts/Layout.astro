---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import { defaultLang, languages } from '../i18n/ui';
import { getLangFromUrl, getRouteKeyFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /**
   * Override de los hreflang alternos. Las páginas estáticas los derivan
   * solas del mapa de rutas (routes/ui.ts), pero un artículo de noticias
   * tiene un slug distinto por idioma que no vive en ese mapa — las rutas
   * de noticias calculan sus propios alternates (ver src/lib/news.ts) y los
   * pasan aquí.
   */
  alternates?: { code: string; href: string | URL }[];
}

const lang = getLangFromUrl(Astro.url);
const routeKey = getRouteKeyFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  image,
  alternates: alternatesProp,
} = Astro.props;

// hreflang alternos: uno por idioma soportado + x-default apuntando al inglés
// (idioma primario). Requiere `site` configurado en astro.config.mjs.
const alternates =
  alternatesProp ??
  (Object.keys(languages) as (keyof typeof languages)[]).map((code) => ({
    code,
    href: new URL(translatePath(routeKey, code), Astro.site),
  }));
const canonicalUrl = alternates.find((a) => a.code === lang)?.href ?? new URL(translatePath(routeKey, lang), Astro.site);
const defaultUrl = alternates.find((a) => a.code === defaultLang)?.href ?? new URL(translatePath(routeKey, defaultLang), Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo.webp" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A23" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <ClientRouter />
  </head>
  <body transition:animate={fade({ duration: '0.25s' })}>
    <slot />

    <script>
      // Restaura el scroll solo cuando LanguageSwitcher.astro guardó una
      // posición (cambio de idioma) — la navegación normal entre páginas
      // distintas no toca sessionStorage y sigue con el scroll-to-top
      // por defecto de Astro.
      document.addEventListener('astro:after-swap', () => {
        const savedY = sessionStorage.getItem('lang-switch-scroll-y');
        if (savedY !== null) {
          window.scrollTo({ top: Number(savedY), left: 0, behavior: 'instant' });
          sessionStorage.removeItem('lang-switch-scroll-y');
        }
      });
    </script>
  </body>
</html>
