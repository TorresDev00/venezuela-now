---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('donate.heading')}>
  <Header />
  <main id="main-content" class="pt-32 pb-24 min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-black text-brand-navy mb-4">{t('donate.heading')}</h1>
      <p class="text-base sm:text-lg text-slate-500">{t('donate.body')}</p>

      {/*
        TODO: pasar el locale actual (en/es) al montar el Payment Element de
        Stripe cuando se construya este componente — Stripe usa `locale` en
        las opciones de Elements para traducir su propio UI (formularios de
        tarjeta, mensajes de error, etc.). Aquí `lang` ya está disponible.
      */}
    </div>
  </main>
  <Footer />
</Layout>
