    <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="20" cy="13" r="5" fill="${Y}" stroke="${Y}" />
      <path d="M11 33c0-6 4-10 9-10s9 4 9 10" />
      <circle cx="8.5" cy="17" r="3.5" />
      <path d="M2.5 31c0-4.2 2.4-6.8 6-6.8" />
      <circle cx="31.5" cy="17" r="3.5" />
      <path d="M37.5 31c0-4.2-2.4-6.8-6-6.8" />
    </g>
  </svg>`,
  // Families displaced — casa partida por una grieta amarilla.
  `<svg viewBox="0 0 40 40" class="block h-full w-full">
    <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 20L20 7l14 13v13H6z" fill="rgba(255,255,255,0.07)" />
      <path d="M20 7l-2.5 7 4.5 4-4 7 3 8" stroke="${Y}" stroke-width="2.2" />
      <circle cx="29.5" cy="29" r="1.1" fill="${Y}" stroke="${Y}" />
      <circle cx="11" cy="28" r="1.1" fill="${Y}" stroke="${Y}" />
    </g>
  </svg>`,
  // Lives lost — vela encendida con halo.
  `<svg viewBox="0 0 40 40" class="block h-full w-full">
    <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 4.5c2.8 3.2 4.2 5.4 4.2 7.6a4.2 4.2 0 0 1-8.4 0c0-2.2 1.4-4.4 4.2-7.6z" fill="${Y}" stroke="${Y}" />
      <rect x="14" y="18" width="12" height="15" rx="2" />
      <path d="M9 35.5h22" />
      <path d="M11 9.5c-1.6 2.2-1.6 5 0 7.2" stroke="${Y}" stroke-opacity="0.5" />
      <path d="M29 9.5c1.6 2.2 1.6 5 0 7.2" stroke="${Y}" stroke-opacity="0.5" />
    </g>
  </svg>`,
];

// Columna 1 sin borde izquierdo; columnas 2 y 3 con separador de 1px.
const situationColClasses = [
  "lg:pr-10",
  "lg:border-l lg:border-white/14 lg:px-10",
  "lg:border-l lg:border-white/14 lg:pl-10",
];

const stats = [
  {
    // TODO: reemplazar por cifra confirmada por el cliente
    number: "100,000+",
    label: t("situation.stat1Label"),
    description: t("situation.stat1Desc"),
    icon: situationIcons[0],
    colClass: situationColClasses[0],
  },
  {
    // TODO: reemplazar por cifra confirmada por el cliente
    number: "20,000+",
    label: t("situation.stat2Label"),
    description: t("situation.stat2Desc"),
    icon: situationIcons[1],
    colClass: situationColClasses[1],
  },
  {
    // TODO: confirmar cifra real con el cliente
    number: "6,500+",
    label: t("situation.stat3Label"),
    description: t("situation.stat3Desc"),
    icon: situationIcons[2],
    colClass: situationColClasses[2],
  },
];

// Línea de sismógrafo: trazo casi plano en y=50 con 3 ráfagas de temblor
// (gaussianas) centradas en x=210/600/990. Generada una sola vez con una
// semilla fija (mulberry32, seed=7) — ver detalle del algoritmo en el brief
// de diseño. Pegada aquí como constante para no calcular aleatoriedad en
// tiempo de ejecución.
const seismographPath =
  "M0 48.88 L6 48.99 L12 51.1 L18 50.46 L24 50.05 L30 49.77 L36 49.92 L42 49.34 L48 50.14 L54 50.65 L60 49.26 L66 48.84 L72 51.01 L78 50.08 L84 48.41 L90 49.17 L96 48.42 L102 50.32 L108 47.68 L114 56.63 L120 45.75 L126 57.66 L132 42.51 L138 39.79 L144 38.42 L150 41.9 L156 52.12 L162 63.03 L168 26.47 L174 75.03 L180 53.52 L186 58.5 L192 63.22 L198 85.45 L204 59.67 L210 82.97 L216 75.46 L222 15 L228 26.14 L234 40.01 L240 45.11 L246 20.91 L252 27.22 L258 63.34 L264 44.21 L270 47.16 L276 48.95 L282 62.79 L288 54.93 L294 53.82 L300 47.15 L306 48.01 L312 45.89 L318 46.59 L324 53.15 L330 48.88 L336 48.37 L342 50.59 L348 49.37 L354 48.46 L360 50.56 L366 51.18 L372 50.13 L378 50.82 L384 50.38 L390 51 L396 49.1 L402 50.07 L408 50.35 L414 50.92 L420 51.1 L426 50.83 L432 50.24 L438 51.22 L444 51.31 L450 50.15 L456 51.08 L462 48.1 L468 50.07 L474 49.1 L480 51.41 L486 50.38 L492 52.38 L498 55.42 L504 50.8 L510 55.44 L516 48.58 L522 53.45 L528 56.84 L534 51.73 L540 42.73 L546 38.37 L552 25.58 L558 23.68 L564 76.88 L570 71.84 L576 59.12 L582 14.35 L588 59.05 L594 57.38 L600 66.97 L606 88.46 L612 33.11 L618 85.7 L624 60.48 L630 69.98 L636 57.54 L642 68.26 L648 32.04 L654 71.84 L660 50.27 L666 52.24 L672 40.28 L678 47.48 L684 44.13 L690 55.28 L696 55.01 L702 52.68 L708 51.48 L714 53.74 L720 50.69 L726 51.24 L732 52.03 L738 49.96 L744 49.09 L750 50.26 L756 50.83 L762 50.93 L768 49.22 L774 50.13 L780 49.95 L786 50.06 L792 49.25 L798 49.41 L804 49.86 L810 49.95 L816 49.2 L822 48.75 L828 49.14 L834 48.66 L840 48.8 L846 51.27 L852 51.85 L858 48.04 L864 48.29 L870 49.4 L876 49.99 L882 52.16 L888 48.5 L894 48.06 L900 54.91 L906 54.28 L912 57.27 L918 50.86 L924 60 L930 46.6 L936 52.77 L942 39.68 L948 51.51 L954 66.76 L960 22.48 L966 32.69 L972 74 L978 74.91 L984 71.35 L990 44.51 L996 38.88 L1002 81.98 L1008 31.74 L1014 40.32 L1020 48.49 L1026 70.02 L1032 44.69 L1038 73.62 L1044 52.27 L1050 47.53 L1056 44.59 L1062 51.06 L1068 44.99 L1074 57.79 L1080 51.22 L1086 56.74 L1092 53.88 L1098 49.96 L1104 49.52 L1110 51.25 L1116 52.27 L1122 50.23 L1128 50.6 L1134 48.86 L1140 50.59 L1146 49.69 L1152 50.29 L1158 50.9 L1164 49.72 L1170 49.51 L1176 49.04 L1182 50.43 L1188 50.54 L1194 51.07 L1200 49.58";
---

<Layout>
  <Header />

  <main id="main-content">
    <Hero />

    <!-- ── Sección: La situación ──────────────────────────────────────── -->
    <section id="situacion" class="bg-white" aria-labelledby="situacion-heading">
      <div class="max-w-7xl mx-auto px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24 reveal">
        <div class="grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-16">
          <h2 id="situacion-heading" class="font-display text-4xl font-black leading-[1.1] text-brand-ink lg:text-[52px]">
            {t("situation.heading")}
          </h2>
          <p class="text-[17px] leading-[1.65] text-[#4A5568] lg:max-w-135 lg:text-lg">
            {t("situation.body")}
          </p>
        </div>
      </div>

      <div class="surface-dark mt-12 overflow-hidden lg:mt-16 reveal">
        <div class="relative max-w-7xl mx-auto px-4 pt-6 pb-7 sm:px-6 lg:px-8 lg:pt-16 lg:pb-30">
          <ul class="grid gap-0 lg:grid-cols-3">
            {stats.map((stat) => (
              <li class={`flex flex-col border-b border-white/14 py-7 last:border-b-0 lg:border-b-0 lg:py-0 ${stat.colClass}`}>
                <div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-0">
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[18px] border border-white/18 bg-[linear-gradient(145deg,rgba(255,255,255,0.12),rgba(255,255,255,0.03))] lg:h-18 lg:w-18 lg:rounded-[20px]">
                    <div class="h-9.5 w-9.5 lg:h-11 lg:w-11">
                      <Fragment set:html={stat.icon} />
                    </div>
                  </div>
                  <div class="font-display text-[44px] leading-none text-white lg:mt-6 lg:text-[64px]">
                    {stat.number}
                  </div>
                </div>
                <p class="mt-4 text-[17px] font-bold text-brand-yellow lg:mt-3">{stat.label}</p>
                <p class="mt-1.5 max-w-75 text-base leading-[1.6] text-[#C3C1E6] lg:mt-2">
                  {stat.description}
                </p>
              </li>
            ))}
          </ul>

          <svg
            aria-hidden="true"
            viewBox="0 0 1200 100"
            preserveAspectRatio="none"
            class="mt-7 h-14 w-full lg:absolute lg:inset-x-0 lg:bottom-2.5 lg:mt-0 lg:h-22.5 lg:w-auto"
          >
            <defs>
              <linearGradient id="situacion-seismo-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1200" y2="0">
                <stop offset="0%" stop-color="var(--color-brand-yellow)" stop-opacity="0" />
                <stop offset="20%" stop-color="var(--color-brand-yellow)" stop-opacity="0.75" />
                <stop offset="80%" stop-color="var(--color-brand-yellow)" stop-opacity="0.75" />
                <stop offset="100%" stop-color="var(--color-brand-yellow)" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path
              d={seismographPath}
              fill="none"
              stroke="url(#situacion-seismo-gradient)"
              stroke-width="1.6"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
      </div>
    </section>

    <ResponseCards />

    <AboutImpact />
    {/* <OrganizationsGrid /> — versión grid estática, conservada como alternativa */}
    <MinistriesShowcase />
    <StoryGrid />
    <CtaBand />
  </main>

  <Footer />
</Layout>

<script>
  // astro:page-load dispara en la carga inicial y tras cada navegación por
  // View Transitions (DOMContentLoaded no vuelve a dispararse en esa
  // navegación). Un IntersectionObserver nuevo por navegación es lo
  // correcto: cada página trae sus propios elementos `.reveal`.
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );

    document.querySelectorAll<Element>('.reveal').forEach((el) => observer.observe(el));
  });
</script>
