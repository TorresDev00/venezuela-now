---
import Layout             from '../layouts/Layout.astro';
import Header             from './Header.astro';
import Hero               from './Hero.astro';
import StoryGrid          from './StoryGrid.astro';
import AboutImpact        from './Aboutimpact.astro';
import ResponseCards      from './ResponseCards.astro';
// import OrganizationsGrid  from './OrganizationsGrid.astro'; // grid estático — conservado como alternativa, ver MinistriesShowcase
import MinistriesShowcase from './MinistriesShowcase.astro';
import CtaBand            from './CtaBand.astro';
import Footer             from './Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Acento amarillo de marca referenciado como variable CSS (no como hex
// suelto) para que los SVG inline de abajo sigan el token del theme.
const Y = "var(--color-brand-yellow)";

const situationIcons = [
