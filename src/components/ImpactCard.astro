---
/**
 * ImpactCard
 * Tarjeta con foto de fondo real, cifra destacada y título. La cifra cuenta
 * desde 0 en cuanto la tarjeta entra en pantalla (no al abrir). Al pulsar el
 * botón (+ → X) una onda circular nace desde el propio botón, cubre la
 * tarjeta y revela un párrafo sobre el trabajo detrás de la cifra, más una
 * cita de cierre.
 *
 * El icono se pasa por <slot /> (igual que en las tarjetas de AboutImpact).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  /** Foto de fondo, importada desde src/assets/img (ej. `import cover from "../assets/img/x.webp"`). */
  coverUrl: ImageMetadata;
  /** Texto alternativo descriptivo de la foto. */
  coverAlt: string;
  /** Cifra grande de portada, ej. "3,000+", "Hundreds", "10,000+". */
  stat: string;
  /** Frase corta bajo la cifra, ej. "niños alcanzados con útiles escolares". */
  statLabel: string;
  /** Párrafo preciso que se revela al abrir la tarjeta (2–4 frases). */
  paragraph: string;
  /** Cita de cierre en cursiva (opcional). */
  quote?: string;
  /** object-position de la foto, para reencuadrar rostros si "center" los corta mal. */
  focalPoint?: string;
  class?: string;
}

const {
  title,
  coverUrl,
  coverAlt,
  stat,
  statLabel,
  paragraph,
  quote,
  focalPoint = "center",
  class: className,
} = Astro.props;

// Si la cifra empieza con un número, se anima con count-up; si no (ej. "Hundreds"),
// se muestra tal cual, sin animación numérica.
const statMatch = stat.trim().match(/^([~≈]?)(\d[\d,]*(?:\.\d+)?)(\+?)$/);
const statIsNumeric = Boolean(statMatch);
const statPrefix = statMatch?.[1] ?? "";
const statRaw = statMatch?.[2] ?? "";
const statSuffix = statMatch?.[3] ?? "";
const statValue = statRaw ? Number(statRaw.replace(/,/g, "")) : 0;
const statDecimals = statRaw.includes(".") ? statRaw.split(".")[1].length : 0;

const icon = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const uid = `ic-${Math.random().toString(36).slice(2, 9)}`;
---

<article
  class:list={["impact-card", className]}
  data-ic-card
  style={`--ic-focal: ${focalPoint};`}
>
  <Image
    src={coverUrl}
    alt={coverAlt}
    class="impact-card__cover"
    loading="lazy"
    widths={[420, 640, 900]}
    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
  />
  <div class="impact-card__scrim" aria-hidden="true"></div>

  <!-- Cara frontal -->
  <div class="impact-card__front" data-ic-front>
    <span class="impact-card__badge" aria-hidden="true"><Fragment set:html={icon} /></span>

    <div class="impact-card__bottom">
      <p class="impact-card__stat">
        {
          statIsNumeric ? (
            <span
              class="impact-card__stat-value"
              data-ic-count
              data-target={statValue}
              data-decimals={statDecimals}
              data-prefix={statPrefix}
              data-suffix={statSuffix}
            >
              {`${statPrefix}${statRaw}${statSuffix}`}
            </span>
          ) : (
            <span class="impact-card__stat-value">{stat}</span>
          )
        }
      </p>
      <p class="impact-card__stat-label">{statLabel}</p>
      <h3 class="impact-card__title" id={`${uid}-title`}>{title}</h3>
    </div>
  </div>

  <!-- Panel que se revela -->
  <div
    class="impact-card__panel"
    id={`${uid}-panel`}
    role="region"
    aria-labelledby={`${uid}-title`}
    aria-hidden="true"
    data-ic-panel
    inert
  >
    <div class="impact-card__panel-inner" data-ic-scroll>
      <p class="impact-card__panel-title" data-reveal style="--i: 0">{title}</p>
      <p class="impact-card__paragraph" data-reveal style="--i: 1">{paragraph}</p>
      {
        quote && (
          <p class="impact-card__quote" data-reveal style="--i: 2">
            {quote}
          </p>
        )
      }
    </div>
  </div>

  <!-- Botón + / X -->
  <button
    type="button"
    class="impact-card__toggle"
    aria-expanded="false"
    aria-controls={`${uid}-panel`}
    aria-label={`Show details: ${title}`}
    data-label-open={`Show details: ${title}`}
    data-label-close={`Hide details: ${title}`}
    data-ic-toggle
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14"></path>
    </svg>
  </button>
</article>

<script>
  const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.target);
    if (!Number.isFinite(target) || el.dataset.counted === "true") return;
    el.dataset.counted = "true";

    const decimals = Number(el.dataset.decimals ?? 0);
    const prefix = el.dataset.prefix ?? "";
    const suffix = el.dataset.suffix ?? "";
    const render = (value: number) => {
      el.textContent =
        prefix +
        value.toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) +
        suffix;
    };

    if (prefersReducedMotion()) return render(target);

    const duration = 1400;
    let start: number | null = null;
    render(0);

    const tick = (now: number) => {
      start ??= now;
      const t = Math.min(Math.max((now - start) / duration, 0), 1);
      const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t); // easeOutExpo
      render(target * eased);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // Cuenta el número de portada en cuanto la tarjeta entra en pantalla.
  const cards = document.querySelectorAll<HTMLElement>("[data-ic-card]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const counter = entry.target.querySelector<HTMLElement>("[data-ic-count]");
        if (counter) countUp(counter);
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.4 },
  );
  cards.forEach((card) => io.observe(card));

  function setOpen(card: HTMLElement, open: boolean) {
    const toggle = card.querySelector<HTMLButtonElement>("[data-ic-toggle]");
    const panel = card.querySelector<HTMLElement>("[data-ic-panel]");
    const front = card.querySelector<HTMLElement>("[data-ic-front]");
    if (!toggle || !panel || !front) return;

    card.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
    panel.toggleAttribute("inert", !open);
    panel.setAttribute("aria-hidden", String(!open));
    front.setAttribute("aria-hidden", String(open));

    if (open) {
      const scroller = panel.querySelector<HTMLElement>("[data-ic-scroll]");
      if (scroller) scroller.scrollTop = 0;
    }
  }

  // Delegación de eventos: funciona con cualquier número de tarjetas
  // y también con View Transitions (<ClientRouter />).
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const card = target?.closest<HTMLElement>("[data-ic-card]");
    if (!card) return;

    if (target?.closest("[data-ic-toggle]")) {
      setOpen(card, !card.classList.contains("is-open"));
      return;
    }
    // Atajo con ratón: clic en la cara frontal también abre
    if (!card.classList.contains("is-open") && target?.closest("[data-ic-front]")) {
      setOpen(card, true);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>("[data-ic-card].is-open").forEach((card) => {
      const hadFocus = card.contains(document.activeElement);
      setOpen(card, false);
      if (hadFocus) card.querySelector<HTMLButtonElement>("[data-ic-toggle]")?.focus();
    });
  });

  // Luz que sigue al cursor (solo ratón)
  document.addEventListener(
    "pointermove",
    (event) => {
      if (event.pointerType !== "mouse") return;
      const card = (event.target as Element | null)?.closest<HTMLElement>("[data-ic-card]");
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--ic-mx", `${event.clientX - rect.left}px`);
      card.style.setProperty("--ic-my", `${event.clientY - rect.top}px`);
    },
    { passive: true },
  );
</script>

<style>
  /* Tokens tomados de la paleta del proyecto (ver src/styles/global.css):
     brand-blue-deep es la variante atenuada reservada para fondos grandes
     de acento, brand-ink es el texto/tinta oscura estándar del sitio. El
     proyecto no tiene sistema de modo oscuro (sin variante `dark:` ni
     toggle), así que esta tarjeta es de tema único, como el resto del sitio. */
  .impact-card {
    --ic-accent: var(--color-brand-blue-deep);
    --ic-on-accent: #ffffff;
    --ic-ease: cubic-bezier(0.77, 0, 0.18, 1);
    --ic-btn: 3.25rem;
    --ic-btn-gap: 1.25rem;
    --ic-origin: calc(100% - var(--ic-btn-gap) - var(--ic-btn) / 2) calc(100% - var(--ic-btn-gap) - var(--ic-btn) / 2);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    min-height: 27rem;
    border-radius: 1.5rem;
    background-color: var(--color-brand-ink);
    color: #ffffff;
    box-shadow: 0 8px 32px rgb(10 10 35 / 0.12);
    transition: transform 0.5s var(--ic-ease);
  }

  .impact-card__cover {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ic-focal, center);
  }

  /* Luz que sigue al cursor */
  .impact-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      22rem circle at var(--ic-mx, 50%) var(--ic-my, 0%),
      rgb(255 255 255 / 0.12),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .impact-card:not(.is-open) {
    cursor: pointer;
  }

  .impact-card:not(.is-open):hover {
    transform: translateY(-4px);
  }

  .impact-card:hover::before {
    opacity: 1;
  }

  /* Degradado permanente sobre la foto, para que el texto siempre sea legible */
  .impact-card__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.85) 0%,
      rgb(0 0 0 / 0.55) 32%,
      rgb(0 0 0 / 0.1) 60%,
      rgb(0 0 0 / 0.35) 100%
    );
    transition:
      opacity 0.45s ease 0.3s,
      filter 0.45s ease 0.3s;
  }

  .is-open .impact-card__scrim {
    opacity: 0;
    transition-delay: 0s;
  }

  /* ---------- Cara frontal ---------- */
  .impact-card__front {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    transition:
      opacity 0.45s ease 0.3s,
      transform 0.7s var(--ic-ease) 0.2s,
      filter 0.45s ease 0.3s;
  }

  .is-open .impact-card__front {
    opacity: 0;
    transform: scale(0.94);
    filter: blur(4px);
    transition-delay: 0s;
  }

  .impact-card__badge {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--ic-accent);
    color: var(--ic-on-accent);
    transition: transform 0.6s var(--ic-ease);
  }

  .impact-card__badge :global(svg) {
    width: 1.625rem;
    height: 1.625rem;
  }

  .impact-card:not(.is-open):hover .impact-card__badge {
    transform: rotate(-8deg) scale(1.06);
  }

  .impact-card__bottom {
    position: relative;
    padding-right: calc(var(--ic-btn) + 0.5rem);
  }

  .impact-card__stat {
    margin: 0;
    line-height: 0.9;
  }

  .impact-card__stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
    font-variant-numeric: tabular-nums;
  }

  .impact-card__stat-label {
    margin: 0.5rem 0 1rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.85);
    max-width: 30ch;
  }

  .impact-card__title {
    font-family: var(--font-display);
    font-weight: 900;
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.15;
    text-wrap: balance;
  }

  /* ---------- Panel revelado ---------- */
  .impact-card__panel {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--ic-accent);
    color: var(--ic-on-accent);
    clip-path: circle(0px at var(--ic-origin));
    transition: clip-path 0.55s var(--ic-ease) 0.15s;
  }

  .is-open .impact-card__panel {
    clip-path: circle(150% at var(--ic-origin));
    transition-duration: 0.8s;
    transition-delay: 0s;
  }

  .impact-card__panel-inner {
    position: relative;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.3) transparent;
  }

  .impact-card__panel-title {
    font-family: var(--font-display);
    font-weight: 900;
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .impact-card__paragraph {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.92);
  }

  .impact-card__quote {
    margin: auto 0 0;
    padding-top: 1.25rem;
    padding-right: calc(var(--ic-btn) + 0.5rem);
    font-family: ui-serif, Georgia, serif;
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
  }

  /* Entrada escalonada del contenido */
  .impact-card [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .impact-card.is-open [data-reveal] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.7s var(--ic-ease);
    transition-delay: calc(280ms + var(--i, 0) * 90ms);
  }

  /* ---------- Botón + / X ---------- */
  .impact-card__toggle {
    position: absolute;
    right: var(--ic-btn-gap);
    bottom: var(--ic-btn-gap);
    z-index: 4;
    display: grid;
    place-items: center;
    width: var(--ic-btn);
    height: var(--ic-btn);
    padding: 0;
    border-radius: 50%;
    border: 2px solid #ffffff;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(6px);
    color: #ffffff;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .impact-card__toggle svg {
    width: 1.375rem;
    height: 1.375rem;
    transition: transform 0.7s var(--ic-ease);
  }

  .impact-card__toggle:hover {
    background: #ffffff;
    color: var(--ic-accent);
  }

  /* Anillo de foco: brand-yellow, igual que el resto de controles del sitio */
  .impact-card__toggle:focus-visible {
    outline: 2px solid var(--color-brand-yellow);
    outline-offset: 3px;
  }

  .impact-card__toggle::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    border: 2px solid #ffffff;
    opacity: 0;
    pointer-events: none;
  }

  .impact-card:not(.is-open):hover .impact-card__toggle::after {
    animation: ic-ping 1.8s var(--ic-ease) infinite;
  }

  @keyframes ic-ping {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    80%,
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  .is-open .impact-card__toggle svg {
    transform: rotate(135deg);
  }

  /* ---------- Movimiento reducido ---------- */
  @media (prefers-reduced-motion: reduce) {
    .impact-card,
    .impact-card__front,
    .impact-card__scrim,
    .impact-card__panel,
    .impact-card__badge,
    .impact-card__toggle svg,
    .impact-card [data-reveal],
    .impact-card.is-open [data-reveal] {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
    .impact-card:not(.is-open):hover {
      transform: none;
    }
    .impact-card:not(.is-open):hover .impact-card__toggle::after {
      animation: none;
    }
  }
</style>
