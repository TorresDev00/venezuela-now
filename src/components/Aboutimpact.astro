---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// TODO: reemplazar con el ID real del video de YouTube cuando el cliente lo confirme.
const VIDEO_ID = "TODO_VIDEO_ID";

// Cifras reales del brochure del cliente (2025).
const stats = [
  { icon: "book", value: "147", suffix: "", label: t("about.stat1Label") },
  { icon: "users", value: "5,000", suffix: "+", label: t("about.stat2Label") },
  { icon: "church", value: "60", suffix: "", label: t("about.stat3Label") },
  { icon: "medical", value: "16,000", suffix: "+", label: t("about.stat4Label") },
];

const icons: Record<string, string> = {
  book:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5-10-5z"/><path d="M6 11.3V16c0 1.3 2.7 3 6 3s6-1.7 6-3v-4.7"/><path d="M22 9v6"/></svg>',
  users:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9" r="2.4"/><path d="M17.5 13.6c2.2.3 3.9 2 3.9 4.4"/></svg>',
  church:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M10 4h4"/><path d="M12 6l-7 4.5V21h14V10.5L12 6z"/><path d="M10 21v-4.5a2 2 0 0 1 4 0V21"/></svg>',
  medical:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5S3.5 15 3.5 9.2A4.7 4.7 0 0 1 12 6.6a4.7 4.7 0 0 1 8.5 2.6C20.5 15 12 20.5 12 20.5z"/><path d="M7 12h2.5l1.5-3 2 6 1.5-3H17"/></svg>',
};
---

<section
  id="quienes-somos"
  class="relative overflow-hidden surface-dark py-24"
  aria-labelledby="about-heading"
>
  <!-- Resplandor decorativo sutil, esquina superior izquierda -->
  <div
    class="pointer-events-none absolute left-0 top-0 h-[420px] w-[640px]"
    style="background: radial-gradient(closest-side, color-mix(in oklch, var(--color-brand-yellow) 13%, transparent), transparent);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-[1260px] grid-cols-1 items-start gap-y-12 px-6 lg:grid-cols-[580px_600px] lg:gap-x-[80px] lg:px-8">

    <!-- Columna izquierda: texto -->
    <div class="reveal">
      <span class="mb-[22px] block text-[13px] font-bold uppercase tracking-[0.22em] text-[#B9B6E0]">
        {t("about.eyebrow")}
      </span>

      <h2 id="about-heading" class="text-white">
        <span class="block font-display text-[30px] font-black leading-[1.1] lg:whitespace-nowrap lg:text-[46px]">
          {t("about.titlePre")}
        </span>
        <span class="mt-1 inline-block w-fit border-b-[3px] border-brand-yellow pb-1 font-serif text-[46px] font-bold italic leading-[1.1] text-white lg:border-b-4 lg:text-[66px]">
          {t("about.titleHighlight")}
        </span>
        {t("about.titlePost") ? <span class="block">{t("about.titlePost")}</span> : null}
      </h2>

      {/* TODO: agregar badges reales cuando el cliente confirme qué acreditaciones tiene */}

      <p class="mt-7 max-w-md font-serif text-[21px] font-semibold italic text-brand-yellow lg:text-[25px]">
        {t("about.tagline")}
      </p>

      <p class="mt-[22px] max-w-[520px] text-base leading-[1.7] text-[#D9D7F1] lg:text-[17px]">
        {t("about.body")}
      </p>

      <a
        href={translatePath("about")}
        class="mt-[34px] inline-flex min-h-[44px] items-center gap-2 border-b-2 border-brand-yellow pb-1.5 text-base font-bold text-white no-underline transition-colors hover:text-brand-yellow focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow"
      >
        {t("about.linkMore")}
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-brand-yellow" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <!-- Columna derecha: video + cifras -->
    <div class="reveal" style="transition-delay: 0.1s">

      <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-white/[.14] bg-brand-ink shadow-[0_28px_64px_rgba(0,0,0,.45)] lg:rounded-[20px]">
        <iframe
          class="absolute inset-0 h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}`}
          title={t("about.videoTitle")}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <p class="mb-6 mt-9 font-serif text-[26px] font-semibold italic text-white lg:text-[28px]">
        {t("about.since")}
      </p>

      <dl class="grid grid-cols-1 gap-x-8 gap-y-7 lg:grid-cols-2">
        {stats.map((stat) => (
          <div class="flex items-start gap-4 border-t border-white/[.12] py-4 first:border-t-0 first:pt-0 lg:border-t-0 lg:py-0">
            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-brand-yellow/[.28] bg-brand-yellow/10 text-brand-yellow [&_svg]:h-7 [&_svg]:w-7"
              aria-hidden="true"
              set:html={icons[stat.icon]}
            />
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="font-display text-[32px] font-black leading-[1.05] text-white lg:text-[38px]">
                {stat.value}{stat.suffix}
              </dd>
              <p class="mt-1 text-[15px] leading-[1.4] text-[#C3C1E6]">
                {stat.label}
              </p>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
