---
import { Image } from "astro:assets";
import VideoPoster from "../assets/img/DSC01246.webp";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Cifras reales del brochure del cliente (2025).
const stats = [
  { icon: "book", value: "147", suffix: "", label: t("about.stat1Label") },
  { icon: "users", value: "5,000", suffix: "+", label: t("about.stat2Label") },
  { icon: "church", value: "60", suffix: "", label: t("about.stat3Label") },
  { icon: "meal", value: "16,000", suffix: "+", label: t("about.stat4Label") },
];

const icons: Record<string, string> = {
  book:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 6c-1.5-1.3-3.5-2-6-2v14c2.5 0 4.5.7 6 2 1.5-1.3 3.5-2 6-2V4c-2.5 0-4.5.7-6 2Z"/><path d="M12 6v14"/></svg>',
  users:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9.5" cy="7.5" r="3.2"/><path d="M2.5 20c0-3.4 3.1-6 7-6s7 2.6 7 6"/><path d="M15.3 4.4a3.2 3.2 0 0 1 0 6.2"/><path d="M17.5 14.3c2.3.6 4 2.8 4 5.7"/></svg>',
  church:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v3M10.3 3.5h3.4"/><path d="M12 5.5 20 11h-2.2v10H6.2V11H4l8-5.5Z"/><path d="M9.8 21v-4.8a2.2 2.2 0 0 1 4.4 0V21"/></svg>',
  meal:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3v7a2 2 0 0 0 4 0V3M7 3v18M11 3v4M15 3c-1.1 1.4-1.5 3-1.5 5s1.5 4 1.5 7v3"/></svg>',
};
---

<section
  id="quienes-somos"
  class="relative overflow-hidden bg-gradient-to-br from-brand-ink to-brand-blue py-24"
  aria-labelledby="about-heading"
>
  <!-- glow decorativo sutil -->
  <div
    class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-brand-yellow/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

    <!-- Columna izquierda: texto -->
    <div class="reveal">
      <span class="block text-xs font-bold tracking-[0.2em] uppercase text-white/60 mb-4">
        {t("about.eyebrow")}
      </span>

      <h2 id="about-heading" class="font-display text-4xl sm:text-5xl font-black text-white leading-[1.05] mb-6">
        {t("about.titlePre")}{" "}
        <span class="relative inline-block font-serif italic font-bold text-white">
          {t("about.titleHighlight")}
          <span
            class="absolute left-0 -bottom-1 h-1 w-full bg-brand-yellow rounded-full"
            aria-hidden="true"
          ></span>
        </span>{" "}
        {t("about.titlePost")}
      </h2>

      {/* TODO: agregar badges reales cuando el cliente confirme qué acreditaciones tiene */}

      <p class="font-serif italic font-bold text-lg sm:text-xl text-brand-yellow mb-5 max-w-md">
        {t("about.tagline")}
      </p>

      <p class="text-white/80 leading-relaxed mb-6 max-w-md">
        {t("about.body")}
      </p>

      <a
        href={translatePath("about")}
        class="inline-flex items-center gap-2 text-sm font-bold text-white border-b-2 border-brand-yellow pb-0.5 hover:text-brand-yellow transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow"
      >
        {t("about.linkMore")}
      </a>
    </div>

    <!-- Columna derecha: video + stats -->
    <div class="reveal" style="transition-delay: 0.1s">

      <!-- Video con thumbnail y botón play -->
      <div
        id="about-video"
        class="glass relative overflow-hidden rounded-3xl aspect-video mb-10"
        data-youtube-id="TODO_VIDEO_ID"
        data-video-title={t("about.videoTitle")}
      >
        <Image
          src={VideoPoster}
          alt={t("about.videoAlt")}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
        <div class="absolute inset-0 bg-black/10" aria-hidden="true"></div>

        <button
          type="button"
          id="about-video-play"
          aria-label={t("about.videoPlayAria")}
          class="absolute inset-0 flex items-center justify-center group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-yellow"
        >
          <span
            class="flex items-center justify-center h-20 w-20 rounded-full bg-white/90 border-4 border-brand-yellow shadow-xl transition-transform duration-300 group-hover:scale-105"
          >
            <svg viewBox="0 0 24 24" class="h-8 w-8 text-brand-blue ml-1" fill="currentColor">
              <path d="M8 5v14l11-7-11-7Z" />
            </svg>
          </span>
        </button>
      </div>

      <!-- Estadísticas -->
      <p class="font-serif italic font-bold text-2xl text-white/90 mb-6">{t("about.since")}</p>

      <dl class="grid grid-cols-2 gap-x-8 gap-y-8">
        {stats.map((stat, i) => (
          <div class="flex items-start gap-3 reveal" style={`transition-delay: ${0.15 + i * 0.05}s`}>
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-white [&_svg]:h-5 [&_svg]:w-5"
              aria-hidden="true"
              set:html={icons[stat.icon]}
            />
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="flex items-baseline gap-0.5">
                <span class="text-3xl font-extrabold text-white">
                  {stat.value}
                </span>
                <span class="text-xl font-serif italic font-bold text-white/90">{stat.suffix}</span>
              </dd>
              <p class="text-sm font-semibold text-white/70 border-b-2 border-white/20 inline-block pb-0.5 mt-0.5">
                {stat.label}
              </p>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  // astro:page-load en vez de ejecutar directo: este componente se renderiza
  // en ambos idiomas de la home, y el botón necesita su listener re-atado
  // tras cada navegación por View Transitions.
  document.addEventListener('astro:page-load', () => {
    // Carga el iframe de YouTube solo al hacer clic (no bloquea LCP, sin JS pesado por defecto)
    const wrapper = document.getElementById("about-video");
    const playBtn = document.getElementById("about-video-play");

    playBtn?.addEventListener("click", () => {
      if (!wrapper) return;
      const videoId = wrapper.dataset.youtubeId;
      if (!videoId || videoId.startsWith("TODO")) {
        console.warn("Missing data-youtube-id in Aboutimpact.astro");
        return;
      }
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = wrapper.dataset.videoTitle ?? "";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      wrapper.innerHTML = "";
      wrapper.appendChild(iframe);
    });
  });
</script>
