---
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import NewsCard from "./NewsCard.astro";
import Pagination from "./Pagination.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import { getPage, type ArticleKind } from "../../lib/news";

interface Props {
  type?: ArticleKind;
  page: number;
}

const { type, page } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Página 1 sin filtro: bento (feature + 2 side + 2 bottom = 5) + 10 grid =
// 15 artículos. Cualquier otra combinación (página siguiente, o cualquier
// filtro) es una grilla uniforme de 12 — ver nota en src/lib/news.ts.
const PAGE_SIZE = 12;
const BENTO_SIZE = 15;
const isBentoPage = page === 1 && !type;

const start = isBentoPage ? 0 : type ? (page - 1) * PAGE_SIZE : BENTO_SIZE + (page - 2) * PAGE_SIZE;
const limit = isBentoPage ? BENTO_SIZE : PAGE_SIZE;

const { items, total } = await getPage(lang, { type, start, limit });

const totalPages = type
  ? Math.max(1, Math.ceil(total / PAGE_SIZE))
  : total <= BENTO_SIZE
    ? total > 0 ? 1 : 0
    : 1 + Math.ceil((total - BENTO_SIZE) / PAGE_SIZE);

// Página pedida más allá del total disponible (y no es la página 1 vacía
// por falta de contenido todavía): no existe.
if (page > 1 && page > totalPages) {
  Astro.response.status = 404;
}

const bento = isBentoPage ? items.slice(0, 5) : [];
const bentoFeature = bento[0];
const bentoSideTop = bento[1];
const bentoSideBottom = bento[2];
const bentoBottomLeft = bento[3];
const bentoBottomRight = bento[4];
const gridItems = isBentoPage ? items.slice(5) : items;

const CHIPS: { label: string; type?: ArticleKind }[] = [
  { label: t("news.chipAll"), type: undefined },
  { label: t("news.chipNews"), type: "news" },
  { label: t("news.chipStory"), type: "story" },
  { label: t("news.chipReport"), type: "report" },
];

function chipHref(chipType?: ArticleKind) {
  return chipType ? `${translatePath("news")}?type=${chipType}` : translatePath("news");
}
---

<Layout title={t("newsPage.heading")}>
  <Header />
  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-10 reveal">
        <h1 class="font-display text-[44px] lg:text-[56px] font-black text-brand-ink">{t("newsPage.heading")}</h1>

        <nav class="flex flex-wrap gap-2" aria-label={t("newsPage.heading")}>
          {
            CHIPS.map((chip) => {
              const active = chip.type === type;
              return (
                <a
                  href={chipHref(chip.type)}
                  aria-current={active ? "page" : undefined}
                  class={`inline-flex h-11 items-center rounded-full border px-5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow ${
                    active
                      ? "border-brand-blue bg-brand-blue text-white"
                      : "border-[#DDE0EA] bg-white text-brand-ink hover:border-brand-blue hover:text-brand-blue"
                  }`}
                >
                  {chip.label}
                </a>
              );
            })
          }
        </nav>
      </div>

      {
        items.length === 0 ? (
          <p class="py-24 text-center text-lg text-slate-500">{t("news.emptyState")}</p>
        ) : (
          <>
            {isBentoPage && (
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-6 lg:grid-rows-[240px_240px_200px] lg:gap-5 mb-10 reveal">
                {bentoFeature && (
                  <div class="md:col-span-2 lg:col-span-4 lg:row-span-2">
                    <NewsCard article={bentoFeature} variant="bento-feature" />
                  </div>
                )}
                {bentoSideTop && (
                  <div class="lg:col-span-2">
                    <NewsCard article={bentoSideTop} variant="bento-side-top" />
                  </div>
                )}
                {bentoSideBottom && (
                  <div class="lg:col-span-2">
                    <NewsCard article={bentoSideBottom} variant="bento-side-bottom" />
                  </div>
                )}
                {bentoBottomLeft && (
                  <div class="lg:col-span-3">
                    <NewsCard article={bentoBottomLeft} variant="bento-bottom" />
                  </div>
                )}
                {bentoBottomRight && (
                  <div class="lg:col-span-3">
                    <NewsCard article={bentoBottomRight} variant="bento-bottom" />
                  </div>
                )}
              </div>
            )}

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-12 reveal">
              {gridItems.map((article) => (
                <NewsCard article={article} variant="grid" />
              ))}
            </div>

            <Pagination page={page} totalPages={totalPages} type={type} />
          </>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -60px 0px" },
    );

    document.querySelectorAll<Element>(".reveal").forEach((el) => observer.observe(el));
  });
</script>
