---
import type { NewsArticleSummary } from "../../lib/news";
import { urlForImage } from "../../lib/sanity";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";

type Variant =
  | "feature"
  | "side"
  | "grid"
  | "compact"
  | "bento-feature"
  | "bento-side-top"
  | "bento-side-bottom"
  | "bento-bottom"
  | "more-news";

interface Props {
  article: NewsArticleSummary;
  variant: Variant;
}

const { article, variant } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const dateFormatter = new Intl.DateTimeFormat(lang === "es" ? "es" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const href = `${translatePath("news")}/${article.slug}`;
const titleId = `news-card-title-${article.id}`;

const KIND_LABEL_KEY = {
  news: "news.chipNews",
  story: "news.chipStory",
  report: "news.chipReport",
} as const;
const kindLabel = t(KIND_LABEL_KEY[article.kind]);

// Puntos de categoría del nuevo lenguaje visual (foto a sangre completa) —
// ya no reutilizan brand-blue/brand-crimson: esos quedan reservados a
// botones/CTAs, ver PASO 1 del brief.
const KIND_DOT_CLASS = {
  news: "bg-[#9A9BFF]",
  story: "bg-[#FF6B88]",
  report: "bg-brand-yellow",
} as const;

// Fondo de respaldo cuando el artículo no tiene imagen — nunca debería
// pasar en producción, pero evita una card vacía si Sanity no tiene foto.
const KIND_GRADIENT_CLASS = {
  news: "from-brand-blue to-brand-blue-deep",
  story: "from-brand-crimson to-brand-ink",
  report: "from-brand-ink to-brand-blue-deep",
} as const;

const isFeature = variant === "feature" || variant === "bento-feature";

const WIDTHS: Record<Variant, number[]> = {
  feature: [480, 768, 1200, 1600],
  "bento-feature": [768, 1200, 1600, 1920],
  side: [320, 480, 640],
  "bento-side-top": [320, 480, 640, 768],
  "bento-side-bottom": [320, 480, 640, 768],
  "bento-bottom": [320, 480, 640, 768],
  grid: [320, 480, 640],
  compact: [240, 360, 480],
  "more-news": [320, 480, 640, 768],
};
const SIZES: Record<Variant, string> = {
  feature: "(min-width: 1024px) 66vw, 100vw",
  "bento-feature": "(min-width: 1024px) 66vw, 100vw",
  side: "(min-width: 1024px) 33vw, 100vw",
  "bento-side-top": "(min-width: 1024px) 33vw, 100vw",
  "bento-side-bottom": "(min-width: 1024px) 33vw, 100vw",
  "bento-bottom": "(min-width: 1024px) 50vw, 100vw",
  grid: "(min-width: 1024px) 33vw, 50vw",
  compact: "(min-width: 1024px) 20vw, 33vw",
  "more-news": "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw",
};

// Altura mobile-first fija; a partir de lg la card vive dentro de una grilla
// con alto de fila explícito (ver NewsListPage.astro) y solo necesita
// estirarse a esa celda — de ahí el h-full en vez de otro valor fijo.
const HEIGHT_CLASS: Record<Variant, string> = {
  feature: "min-h-105 lg:min-h-120",
  "bento-feature": "h-[400px] lg:h-full",
  side: "min-h-55",
  "bento-side-top": "h-[290px] lg:h-full",
  "bento-side-bottom": "h-[240px] lg:h-full",
  "bento-bottom": "h-[240px] lg:h-full",
  grid: "min-h-70",
  compact: "min-h-45",
  "more-news": "h-[240px]",
};

const TITLE_CLASS: Record<Variant, string> = {
  feature: "text-[26px] lg:text-[36px] leading-[1.12]",
  "bento-feature": "text-[26px] lg:text-[36px] leading-[1.12]",
  side: "text-[21px] lg:text-[22px] leading-[1.18]",
  "bento-side-top": "text-[24px] leading-[1.18]",
  "bento-side-bottom": "text-[21px] lg:text-[22px] leading-[1.18]",
  "bento-bottom": "text-[20px] lg:text-[21px] leading-[1.18]",
  grid: "text-[20px] lg:text-[21px] leading-[1.18]",
  compact: "text-[18px] leading-[1.18]",
  "more-news": "text-[21px] lg:text-[22px] leading-[1.18]",
};

const PADDING_CLASS = isFeature ? "p-[22px] lg:p-8" : "p-[22px] lg:p-6";

// Prioridad: la destacada siempre usa 40% (independientemente del tipo de
// artículo que caiga ahí); el Report usa el tope de la foto para no cortar
// el horizonte en fotos de inundación; el resto, 30% para no cortar caras.
const objectPositionClass = isFeature
  ? "object-[center_40%]"
  : article.kind === "report"
    ? "object-top"
    : "object-[center_30%]";

const builder = article.image ? urlForImage(article.image.raw) : null;
const srcset = builder
  ? WIDTHS[variant].map((w) => `${builder.width(w).fit("crop").auto("format").url()} ${w}w`).join(", ")
  : null;
const fallbackSrc = builder ? builder.width(WIDTHS[variant].at(-1)!).fit("crop").auto("format").url() : null;
const imgAlt = article.image?.alt || article.title;
---

<article class={`group relative isolate overflow-hidden rounded-3xl bg-brand-ink ${HEIGHT_CLASS[variant]}`}>
  {
    article.image && srcset && fallbackSrc ? (
      <img
        src={fallbackSrc}
        srcset={srcset}
        sizes={SIZES[variant]}
        alt={imgAlt}
        loading={isFeature ? undefined : "lazy"}
        decoding="async"
        class={`absolute inset-0 h-full w-full object-cover ${objectPositionClass} saturate-[.88] motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.04]`}
      />
    ) : (
      <div class={`absolute inset-0 bg-gradient-to-br ${KIND_GRADIENT_CLASS[article.kind]}`} aria-hidden="true" />
    )
  }

  <div
    class="absolute inset-0"
    style="background:linear-gradient(180deg,rgba(9,14,38,0) 0%,rgba(9,14,38,0) 34%,rgba(9,14,38,0.72) 66%,rgba(9,14,38,0.96) 100%)"
  />

  <div class={`absolute inset-x-0 bottom-0 flex flex-col gap-2.5 ${PADDING_CLASS}`}>
    <div class="flex flex-wrap items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-white/90">
      <span class={`h-[7px] w-[7px] shrink-0 rounded-full ${KIND_DOT_CLASS[article.kind]}`} aria-hidden="true" />
      <span>{kindLabel}</span>
      <span class="font-normal normal-case tracking-normal text-white/72">
        · {dateFormatter.format(new Date(article.publishedAt))}
      </span>
      {
        article.isFallback && (
          <span class="font-normal normal-case tracking-normal text-white/72">· {t("news.fallbackBadge")}</span>
        )
      }
    </div>

    <h3
      id={titleId}
      class={`font-display text-white line-clamp-3 [text-shadow:0_1px_2px_rgba(0,0,0,0.25)] ${TITLE_CLASS[variant]}`}
    >
      {article.title}
    </h3>

    {
      isFeature && (
        <p class="line-clamp-2 text-[15px] leading-normal text-white/85 lg:text-[16px]">{article.excerpt}</p>
      )
    }
  </div>

  <a
    href={href}
    class="after:absolute after:inset-0 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-brand-blue"
  >
    <span class="sr-only">{article.title}</span>
  </a>
</article>
