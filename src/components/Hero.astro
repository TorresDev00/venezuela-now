---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const dateFormatter = new Intl.DateTimeFormat(lang === "es" ? "es" : "en-US", {
  day: "numeric",
  month: "long",
  timeZone: "UTC",
});

function slugFor(id: string) {
  return id.slice(id.indexOf("/") + 1);
}

// Las noticias (y su foto) vienen de la misma colección que StoryGrid/news —
// así la foto de fondo del Hero siempre corresponde a una noticia real, no a
// una imagen inventada. Rotan las 3 más recientes.
const news = (await getCollection("stories", ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="hero relative h-screen overflow-hidden" aria-label={t("hero.sectionAria")}>
  <!-- Capa 1: fotos, una por noticia. Crossfade por opacidad — mismo patrón
       verificado en MinistriesShowcase (todas precargadas de antemano,
       opacidad 0/100 según cuál está activa, loading eager solo en la primera). -->
  <div class="absolute inset-0 surface-dark" aria-hidden="true">
    {news.map((story, i) => (
      <div
        class="hero-photo absolute inset-0 opacity-0 scale-105 transition-[opacity,transform] duration-(--hero-transition) ease-out motion-reduce:transition-none data-[active=true]:opacity-100 data-[active=true]:scale-100"
        data-index={i}
        data-active={i === 0 ? "true" : "false"}
      >
        <Image
          src={story.data.image}
          alt={story.data.imageAlt}
          class="w-full h-full object-cover"
          widths={[480, 768, 1200, 1600]}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : undefined}
        />
      </div>
    ))}
  </div>

  <!-- Overlay estándar para legibilidad con foto real -->
  <div class="absolute inset-0 photo-overlay-strong pointer-events-none" aria-hidden="true"></div>

  <!-- Scrim de amortiguación: se oscurece brevemente a mitad de cada crossfade
       para disimular el salto de brillo entre fotos con luminosidad distinta
       (ver PARTE B del brief) — no reemplaza el overlay de arriba, se suma. -->
  <div class="hero-scrim-pulse absolute inset-0 bg-brand-ink opacity-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Contenido -->
  <div class="relative z-10 w-full h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 lg:pb-14 pt-24 lg:pt-28 flex flex-col justify-end lg:justify-between gap-8">

    <div class="max-w-md">
      <!-- Badge de urgencia -->
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-crimson/15 border border-brand-crimson/40 px-3.5 py-1.5 mb-4">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-brand-crimson opacity-75 animate-ping motion-reduce:animate-none"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-crimson"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wide text-red-200">{t("hero.urgencyBadge")}</span>
      </div>

      <!-- Tarjeta glass -->
      <div class="glass rounded-3xl p-6 sm:p-7">
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-3">
          {t("hero.title")}
        </h1>
        <p class="text-white/75 text-base sm:text-lg leading-relaxed mb-6">
          {t("hero.subtitle")}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 mb-5">
          <a
            href={translatePath("donate")}
            class="inline-flex items-center justify-center rounded-full bg-brand-yellow text-brand-ink font-bold text-base px-7 py-3.5 shadow-lg shadow-brand-yellow/30 hover:brightness-105 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-yellow/40 active:scale-95 active:translate-y-0 transition-all duration-150 motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
          >
            {t("hero.ctaPrimary")}
          </a>
          <a
            href="#situacion"
            class="inline-flex items-center justify-center rounded-full border-2 border-white/40 text-white font-semibold text-base px-7 py-3.5 hover:bg-white/10 hover:border-white/60 transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
          >
            {t("hero.ctaSecondary")}
          </a>
        </div>

        <!-- Confianza -->
        <p class="flex items-center gap-2 text-sm text-white/60 select-none">
          <span aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none" />
              <path fill="currentColor" d="M12 13a1.49 1.49 0 0 0-1 2.61V17a1 1 0 0 0 2 0v-1.39A1.49 1.49 0 0 0 12 13m5-4V7A5 5 0 0 0 7 7v2a3 3 0 0 0-3 3v7a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-7a3 3 0 0 0-3-3M9 7a3 3 0 0 1 6 0v2H9Zm9 12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1Z" />
            </svg>
          </span>
          {t("hero.trustBadge")}
        </p>
      </div>
    </div>

    <!-- Noticias sincronizadas con la foto de fondo -->
    <div class="hero-news w-full lg:max-w-xl" aria-label={t("hero.newsLabel")}>
      <div class="flex items-center gap-1.5 mb-2">
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-brand-yellow opacity-75 animate-ping motion-reduce:animate-none"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-yellow">{t("hero.newsLabel")}</span>
      </div>

      <div class="hero-news-text relative min-h-19 sm:min-h-16" aria-live="polite" aria-atomic="true">
        {news.map((story, i) => (
          <a
            href={`${translatePath("news")}/${slugFor(story.id)}`}
            class="hero-news-item absolute inset-0 flex flex-col justify-center gap-1 opacity-0 translate-y-2 pointer-events-none transition-[opacity,transform] duration-(--hero-transition) ease-out motion-reduce:transition-none motion-reduce:translate-y-0 data-[active=true]:opacity-100 data-[active=true]:translate-y-0 data-[active=true]:pointer-events-auto rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
            data-index={i}
            data-active={i === 0 ? "true" : "false"}
            aria-hidden={i === 0 ? "false" : "true"}
            tabindex={i === 0 ? "0" : "-1"}
          >
            <p class="text-white font-bold text-lg sm:text-xl leading-snug">
              {story.data.title}
            </p>
            <time class="text-white/55 text-xs" datetime={story.data.date.toISOString()}>
              {dateFormatter.format(story.data.date)}
            </time>
          </a>
        ))}
      </div>

      <!-- Dots con barra de progreso: se rellenan durante el ciclo automático -->
      <div class="flex items-center gap-2 mt-3">
        {news.map((story, i) => (
          <button
            type="button"
            class="hero-news-dot relative h-0.75 w-7 rounded-full bg-white/25 overflow-hidden cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
            data-index={i}
            data-active={i === 0 ? "true" : "false"}
            aria-current={i === 0 ? "true" : "false"}
            aria-label={`${t("hero.newsDotAria")} ${story.data.title}`}
          >
            <span class="hero-news-dot-fill absolute inset-y-0 left-0 w-0 bg-brand-yellow"></span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll hint: contenedor propio con fondo para que no se confunda con widgets flotantes (ej. dev toolbar). Solo desktop — en móvil el espacio ya lo ocupa el bloque de noticias. -->
  <div
    class="hidden lg:flex absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex-col items-center gap-1 text-white/70 bg-brand-ink/30 backdrop-blur-sm rounded-full px-4 py-2"
    aria-hidden="true"
  >
    <span class="text-[10px] tracking-widest uppercase">{t("hero.scrollHint")}</span>
    <svg class="w-4 h-4 animate-bounce mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>

<style>
  /* Fuente única de la duración del crossfade (foto + texto de noticia
     comparten esta variable, ver PARTE B del brief). Para depurar en cámara
     lenta, cambiar temporalmente este valor a algo como 3000ms. */
  .hero {
    --hero-transition: 1300ms;
  }

  @keyframes hero-news-progress {
    from { width: 0%; }
    to { width: 100%; }
  }
  /* La barra de progreso del dot activo es también el reloj de la rotación:
     al terminar (animationend, ver script) se avanza a la siguiente noticia.
     Pausarla con :hover/:focus-within pausa foto + texto + progreso a la vez,
     sin necesidad de un timer JS aparte. */
  .hero-news-dot[data-active="true"] .hero-news-dot-fill {
    animation: hero-news-progress 5600ms linear forwards;
  }
  .hero-news:hover .hero-news-dot-fill,
  .hero-news:focus-within .hero-news-dot-fill {
    animation-play-state: paused;
  }

  /* Amortigua el salto de brillo entre fotos de luminosidad distinta:
     oscurece el scrim a mitad del crossfade y vuelve a su opacidad normal. */
  @keyframes hero-scrim-pulse {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.45; }
  }
  .hero-scrim-pulse.is-pulsing {
    animation: hero-scrim-pulse var(--hero-transition) ease-in-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scrim-pulse.is-pulsing {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".hero-news").forEach((root) => {
      const section = root.closest("section");
      const photos = Array.from(section?.querySelectorAll<HTMLElement>(".hero-photo") ?? []);
      const textItems = Array.from(root.querySelectorAll<HTMLElement>(".hero-news-item"));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".hero-news-dot"));
      const scrimPulse = section?.querySelector<HTMLElement>(".hero-scrim-pulse");
      const total = dots.length;
      if (total === 0) return;

      let activeIndex = textItems.findIndex((el) => el.dataset.active === "true");
      if (activeIndex === -1) activeIndex = 0;

      function setActive(index: number, active: boolean) {
        const photo = photos[index];
        if (photo) photo.dataset.active = active ? "true" : "false";

        const text = textItems[index];
        if (text) {
          text.dataset.active = active ? "true" : "false";
          text.setAttribute("aria-hidden", active ? "false" : "true");
          text.tabIndex = active ? 0 : -1;
        }

        const dot = dots[index];
        if (dot) {
          dot.dataset.active = active ? "true" : "false";
          dot.setAttribute("aria-current", active ? "true" : "false");
        }
      }

      function restartFill(index: number) {
        const fill = dots[index]?.querySelector<HTMLElement>(".hero-news-dot-fill");
        if (!fill) return;
        // Truco estándar para reiniciar una animación CSS ya en curso: se
        // quita, se fuerza reflow leyendo un layout prop, y se restaura.
        fill.style.animation = "none";
        void fill.offsetWidth;
        fill.style.animation = "";
      }

      function pulseScrim() {
        if (!scrimPulse) return;
        scrimPulse.classList.remove("is-pulsing");
        void scrimPulse.offsetWidth;
        scrimPulse.classList.add("is-pulsing");
      }

      function activate(index: number) {
        const next = ((index % total) + total) % total;
        if (next === activeIndex) {
          restartFill(next);
          return;
        }
        pulseScrim();
        setActive(activeIndex, false);
        activeIndex = next;
        setActive(activeIndex, true);
      }

      dots.forEach((dot, i) => {
        const fill = dot.querySelector<HTMLElement>(".hero-news-dot-fill");
        fill?.addEventListener("animationend", () => {
          if (dot.dataset.active === "true") activate(i + 1);
        });
        dot.addEventListener("click", () => activate(i));
      });
    });
  });
</script>
