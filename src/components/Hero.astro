---
import HeroImage from "../assets/img/DSC01474.webp";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="relative h-screen overflow-hidden flex items-end lg:items-center" aria-label={t("hero.sectionAria")}>
  <div class="absolute inset-0 bg-brand-navy" aria-hidden="true">
    <img
        src={HeroImage.src}
        alt={t("hero.imageAlt")}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
  </div>

  <!-- Overlay estándar para legibilidad con foto real -->
  <div class="absolute inset-0 photo-overlay-strong pointer-events-none" aria-hidden="true"></div>

  <!-- Contenido -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-24 lg:pt-0">
    <div class="max-w-lg">

      <!-- Tarjeta glass -->
      <div class="glass rounded-3xl p-7 sm:p-9">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4">
          {t("hero.title")}
        </h1>
        <p class="text-white/75 text-lg leading-relaxed mb-7">
          {t("hero.subtitle")}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 mb-6">
          <a
            href={translatePath("donate")}
            class="inline-flex items-center justify-center rounded-full bg-brand-gold text-brand-navy font-bold text-base px-7 py-3.5 hover:brightness-105 active:scale-95 transition-all duration-150 shadow-lg shadow-brand-gold/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
          >
            {t("hero.ctaPrimary")}
          </a>
          <a
            href="#situacion"
            class="inline-flex items-center justify-center rounded-full border-2 border-brand-navy text-brand-navy font-semibold text-base px-7 py-3.5 hover:bg-brand-navy hover:text-white transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-navy"
          >
            {t("hero.ctaSecondary")}
          </a>
        </div>

        <!-- Confianza -->
        <p class="flex items-center gap-2 text-sm text-slate-500 select-none">
          <span aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none" />
              <path fill="currentColor" d="M12 13a1.49 1.49 0 0 0-1 2.61V17a1 1 0 0 0 2 0v-1.39A1.49 1.49 0 0 0 12 13m5-4V7A5 5 0 0 0 7 7v2a3 3 0 0 0-3 3v7a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-7a3 3 0 0 0-3-3M9 7a3 3 0 0 1 6 0v2H9Zm9 12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1Z" />
            </svg>
          </span>
          {t("hero.trustBadge")}
        </p>
      </div>
    </div>
  </div>

  <!-- Scroll hint: contenedor propio con fondo para que no se confunda con widgets flotantes (ej. dev toolbar) -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-1 text-white/70 bg-brand-navy/30 backdrop-blur-sm rounded-full px-4 py-2"
    aria-hidden="true"
  >
    <span class="text-[10px] tracking-widest uppercase">{t("hero.scrollHint")}</span>
    <svg class="w-4 h-4 animate-bounce mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
