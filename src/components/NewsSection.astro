---
import NewsCard from "./news/NewsCard.astro";
import { getLatest, type ArticleKind } from "../lib/news";
import { useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

// `lang` llega como prop, no se deriva de Astro.url: este componente se
// renderiza como Server Island (server:defer), y esa sub-request siempre
// pega a /_server-islands/NewsSection sin el prefijo de idioma de la página
// que lo incluyó — detectarlo con getLangFromUrl() aquí daría siempre el
// idioma por defecto, sin importar en qué idioma esté viendo el home.
const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const items = await getLatest(lang, 6);
const feature = items[0];
const side = items.slice(1, 3);
const compact = items.slice(3, 6);

const CHIPS: { label: string; type: ArticleKind }[] = [
  { label: t("news.chipNews"), type: "news" },
  { label: t("news.chipStory"), type: "story" },
  { label: t("news.chipReport"), type: "report" },
];
---

<section id="historias" class="py-16" style="background-color: var(--color-surface-cool)" aria-labelledby="historias-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <div>
        <h2 id="historias-heading" class="font-display text-4xl sm:text-5xl font-black text-brand-ink mb-2">
          {t("stories.heading")}
        </h2>
        <p class="text-base sm:text-lg text-slate-500 max-w-xl mb-4">{t("stories.subtitle")}</p>
        <nav class="flex flex-wrap gap-2" aria-label={t("stories.heading")}>
          {
            CHIPS.map((chip) => (
              <a
                href={`${translatePath("news")}?type=${chip.type}`}
                class="rounded-full border border-slate-200 px-3.5 py-1.5 text-sm font-semibold text-brand-ink transition-colors hover:border-brand-blue hover:text-brand-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
              >
                {chip.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    {
      items.length === 0 ? (
        <p class="py-12 text-center text-slate-500">{t("news.emptyState")}</p>
      ) : (
        <>
          <div class="grid gap-5 lg:grid-cols-3 mb-5">
            {feature && (
              <div class="lg:col-span-2">
                <NewsCard article={feature} variant="feature" />
              </div>
            )}
            <div class="grid gap-5 lg:grid-rows-2">
              {side.map((article) => (
                <NewsCard article={article} variant="side" />
              ))}
            </div>
          </div>

          {compact.length > 0 && (
            <div class="grid gap-5 sm:grid-cols-3 mb-10">
              {compact.map((article) => (
                <NewsCard article={article} variant="compact" />
              ))}
            </div>
          )}
        </>
      )
    }

    <div class="text-center">
      <a
        href={translatePath("news")}
        class="inline-flex items-center justify-center rounded-full bg-brand-blue px-7 py-3.5 font-bold text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
      >
        {t("news.viewAllButton")}
      </a>
    </div>
  </div>
</section>
