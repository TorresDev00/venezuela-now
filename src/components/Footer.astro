---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navLinks = [
  { href: "#situacion",    label: t("nav.ourWork") },
  { href: "#involucrarse", label: t("nav.getInvolved") },
  { href: "#historias",    label: t("nav.news") },
  { href: translatePath("donate"), label: t("nav.donate") },
];

const legalLinks = [
  { href: translatePath("privacy"), label: t("footer.privacy") },
  { href: translatePath("terms"),   label: t("footer.terms") },
];

const year = new Date().getFullYear();
---

<footer id="acerca" class="bg-brand-navy text-white pt-16 pb-10" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">{t("footer.srHeading")}</h2>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">

      <!-- Marca y misión -->
      <div class="lg:col-span-2">
        <a href={translatePath("home")} aria-label={t("nav.homeAria")}>
          <img
            src="/logo.png"
            alt="Venezuela NOW"
            class="h-12 w-auto mb-5"
            loading="lazy"
          />
        </a>
        <p class="text-white/65 text-sm leading-relaxed max-w-xs">
          {t("footer.mission")}
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/35 mb-5">{t("footer.navHeading")}</h3>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-white/65 hover:text-white text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/35 mb-5">{t("footer.legalHeading")}</h3>
        <ul class="space-y-3">
          {legalLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-white/65 hover:text-white text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a
            href={translatePath("donate")}
            class="inline-flex items-center justify-center rounded-full bg-brand-gold text-brand-navy font-bold text-sm px-5 py-2.5 hover:brightness-105 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
          >
            {t("footer.donateButton")}
          </a>
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
      <div class="text-white/35 text-xs space-y-1">
        {/* TODO: reemplazar por el EIN real de Venezuela NOW, Inc. una vez confirmado */}
        <p>{t("footer.orgLine")}</p>
        <p>© {year} Venezuela NOW, Inc. {t("footer.allRightsReserved")}</p>
      </div>
      <p class="text-white/35 text-xs max-w-xs text-left sm:text-right leading-relaxed">
        {t("footer.stripeLine1")}<br />
        {t("footer.stripeLine2")}
      </p>
    </div>
  </div>
</footer>
