---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// timeZone: "UTC" evita que las fechas (parseadas como medianoche UTC desde
// el frontmatter) se muestren un día antes en servidores con zona horaria
// negativa respecto a UTC.
const dateFormatter = new Intl.DateTimeFormat(lang === "es" ? "es" : "en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const allStories = await getCollection("stories", ({ id }) => id.startsWith(`${lang}/`));
const sorted = allStories.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.find((s) => s.data.featured) ?? sorted[0];
const secondary = sorted.filter((s) => s.id !== featured.id).slice(0, 2);

function slugFor(id: string) {
  return id.slice(id.indexOf("/") + 1);
}
---

<section id="historias" class="py-16 bg-white" aria-labelledby="historias-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex items-end justify-between mb-16 reveal">
      <div>
        <h2 id="historias-heading" class="font-display text-4xl sm:text-5xl font-black text-brand-ink mb-2">
          {t("stories.heading")}
        </h2>
        <p class="text-base sm:text-lg text-slate-500 max-w-xl">{t("stories.subtitle")}</p>
      </div>
      <a
        href={translatePath("news")}
        class="hidden sm:inline-flex text-sm font-semibold text-brand-blue hover:text-brand-ink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
      >
        {t("stories.viewAll")}
      </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Tarjeta destacada -->
      <article class="lg:col-span-2 relative overflow-hidden rounded-3xl reveal min-h-96 sm:min-h-96 flex flex-col pt-24" aria-labelledby="featured-heading">
        <Image
          src={featured.data.image}
          alt={featured.data.imageAlt}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 66vw, 100vw"
        />
        <div class="absolute inset-0 photo-overlay-strong" aria-hidden="true"></div>

        <div class="relative mt-auto p-8 sm:p-10">
          <span class="inline-block bg-brand-crimson text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
            {featured.data.tag}
          </span>
          <h3 id="featured-heading" class="text-2xl sm:text-3xl font-extrabold text-white mb-3 leading-tight">
            {featured.data.title}
          </h3>
          <p class="text-white/75 mb-5 leading-relaxed">{featured.data.excerpt}</p>
          <div class="flex items-center justify-between">
            <time class="text-white/45 text-sm" datetime={featured.data.date.toISOString()}>
              {dateFormatter.format(featured.data.date)}
            </time>
            <a
              href={`${translatePath("news")}/${slugFor(featured.id)}`}
              class="text-brand-yellow text-sm font-bold hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
            >
              {t("stories.readMore")}
            </a>
          </div>
        </div>
      </article>

      <!-- Tarjetas secundarias -->
      <div class="flex flex-col gap-6">
        {secondary.map((story, i) => (
          <article
            class="relative overflow-hidden rounded-3xl flex flex-col flex-1 reveal min-h-44"
            style={`transition-delay: ${(i + 1) * 0.1}s`}
            aria-labelledby={`story-heading-${i}`}
          >
            <Image
              src={story.data.image}
              alt={story.data.imageAlt}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 33vw, 100vw"
            />
            <div class="absolute inset-0 photo-overlay-strong" aria-hidden="true"></div>

            <a
              href={`${translatePath("news")}/${slugFor(story.id)}`}
              class="relative mt-auto p-6 flex flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
              aria-labelledby={`story-heading-${i}`}
            >
              <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest px-2.5 py-1 rounded-full mb-2 w-fit">
                {story.data.tag}
              </span>
              <h3 id={`story-heading-${i}`} class="text-base font-bold text-white leading-snug mb-2">
                {story.data.title}
              </h3>
              <time class="text-white/45 text-xs" datetime={story.data.date.toISOString()}>
                {dateFormatter.format(story.data.date)}
              </time>
            </a>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>
