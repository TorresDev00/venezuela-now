---
interface Props {
  number: string;
  label: string;
  description: string;
  accent?: "crimson" | "blue" | "yellow";
}
const { number, label, description, accent = "crimson" } = Astro.props;

const accentBorder: Record<string, string> = {
  crimson: "border-t-brand-crimson",
  blue: "border-t-brand-blue",
  yellow: "border-t-brand-yellow",
};
---

<div class={`glass-light rounded-3xl p-8 flex flex-col h-full border-t-4 ${accentBorder[accent]}`}>
  <div class="font-display text-5xl sm:text-6xl font-black text-brand-ink leading-none mb-2">{number}</div>
  <div class="text-brand-blue font-bold text-sm uppercase tracking-wide mb-3">{label}</div>
  <p class="text-slate-600 text-sm leading-relaxed">{description}</p>
</div>
